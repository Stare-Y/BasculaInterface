<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BasculaInterface.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BasculaInterface">

    <!-- fix-session-inactivity-timeout design.md Decision 1: a Shell-level tap observer so any
         touch anywhere in the app resets the inactivity timer, not just the login screen's own
         input. Observing here does not consume the gesture, so pages' own Clicked/Tapped handlers
         are unaffected. -->
    <Shell.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnAnyTap" />
    </Shell.GestureRecognizers>

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
