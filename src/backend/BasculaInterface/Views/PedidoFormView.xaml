<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BasculaInterface.Views.PedidoFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BasculaInterface.Views.PopUps"
    xmlns:models="clr-namespace:BasculaInterface.Models"
    Title="Pedido a Proveedor"
    BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                      Dark={StaticResource BlackTheme}}">

    <Grid>
        <Grid
            Padding="{OnPlatform WinUI=30}"
            BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                              Dark={StaticResource BlackTheme}}"
            ColumnDefinitions="{OnPlatform WinUI='*,3*'}"
            ColumnSpacing="{OnPlatform WinUI=30}"
            RowDefinitions="{OnPlatform Android='50,*,10,75'}">

            <!-- Side panel (WinUI) / Bottom bar (Android) -->
            <Border
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                  Dark={StaticResource BlackGray}}"
                IsVisible="{OnPlatform Android=False,
                                       WinUI=True}"
                Shadow="{OnPlatform WinUI={StaticResource DefaultShadow}}"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0">

                <Grid
                    RowDefinitions="*,*,*"
                    RowSpacing="15">

                    <Button
                        x:Name="BtnSave"
                        AutomationProperties.AutomationId="PedidoForm_Save"
                        Grid.Row="0"
                        Clicked="BtnSave_Clicked"
                        Style="{StaticResource BotonPrincipal}"
                        Text="Guardar" />

                    <Button
                        x:Name="BtnDelete"
                        AutomationProperties.AutomationId="PedidoForm_Delete"
                        BackgroundColor="DarkRed"
                        Grid.Row="1"
                        Clicked="BtnDelete_Clicked"
                        IsVisible="False"
                        Style="{StaticResource Boton}"
                        Text="Eliminar"
                        TextColor="White" />

                    <Button
                        x:Name="BtnBack"
                        AutomationProperties.AutomationId="PedidoForm_Back"
                        Grid.Row="2"
                        Clicked="BtnBack_Clicked"
                        Style="{StaticResource Boton}"
                        Text="Regresar" />
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid
                Grid.Row="{OnPlatform Android=1}"
                Grid.Column="{OnPlatform WinUI=1}">

                <ScrollView
                    Padding="20">

                    <VerticalStackLayout
                        Spacing="20">

                        <Label
                            x:Name="LblTitle"
                            FontAttributes="Bold"
                            FontSize="28"
                            HorizontalOptions="Start"
                            Style="{StaticResource Label}"
                            Text="Nuevo Pedido"
                            TextColor="{AppThemeBinding Light={StaticResource 4},
                                                        Dark={StaticResource 2}}" />

                        <Label
                            x:Name="LblStatus"
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Start"
                            IsVisible="False" />

                        <!-- Provider -->
                        <Border
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                              Dark={StaticResource BlackGray}}"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="20"
                                        Style="{StaticResource Label}"
                                        Text="Proveedor"
                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                    Dark={StaticResource 1}}" />
                                    <Label
                                        x:Name="LblProviderName"
                                        FontSize="16"
                                        Style="{StaticResource Label}"
                                        Text="Sin proveedor seleccionado" />
                                </VerticalStackLayout>
                                <Button
                                    x:Name="BtnPickProvider"
                                    Grid.Column="1"
                                    Clicked="BtnPickProvider_Clicked"
                                    Style="{StaticResource Boton}"
                                    Text="Seleccionar"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Expected arrival -->
                        <Border
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                              Dark={StaticResource BlackGray}}"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource Label}"
                                    Text="Fecha Esperada de Llegada"
                                    TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                Dark={StaticResource 1}}" />
                                <DatePicker
                                    x:Name="DatePickerExpectedArrival" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Notes -->
                        <Border
                            Padding="15"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                              Dark={StaticResource BlackGray}}"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource Label}"
                                    Text="Notas"
                                    TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                Dark={StaticResource 1}}" />
                                <Editor
                                    x:Name="EditorNotes"
                                    HeightRequest="100"
                                    Placeholder="Notas opcionales..." />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Lines section (only shown once the header exists) -->
                        <VerticalStackLayout x:Name="LinesSection" IsVisible="False" Spacing="15">

                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalOptions="Start"
                                Style="{StaticResource Label}"
                                Text="Productos del Pedido"
                                TextColor="{AppThemeBinding Light={StaticResource 4},
                                                            Dark={StaticResource 2}}" />

                            <CollectionView
                                x:Name="LinesCollectionView"
                                HeightRequest="320"
                                VerticalOptions="Start">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PedidoLineViewRow">
                                        <Border
                                            Padding="15"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                                              Dark={StaticResource BlackGray}}"
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="0">
                                            <VerticalStackLayout Spacing="10">

                                                <!-- Collapsed summary row — tap to expand/collapse -->
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="LineRowHeader_Tapped" />
                                                    </Grid.GestureRecognizers>

                                                    <Label
                                                        Grid.Column="0"
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        Style="{StaticResource Label}"
                                                        Text="{Binding ChevronGlyph}"
                                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                                    Dark={StaticResource 2}}"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="17"
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        LineBreakMode="TailTruncation"
                                                        Style="{StaticResource Label}"
                                                        Text="{Binding ProductName}"
                                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                                    Dark={StaticResource 2}}"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="2"
                                                        FontSize="14"
                                                        Style="{StaticResource Label}"
                                                        Text="{Binding PendingText}"
                                                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                    Dark={StaticResource 1}}"
                                                        VerticalOptions="Center" />

                                                    <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                                                        <Border
                                                            BackgroundColor="{Binding StatusColor}"
                                                            HeightRequest="10"
                                                            StrokeShape="RoundRectangle 5"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center"
                                                            WidthRequest="10" />
                                                        <Label
                                                            FontSize="13"
                                                            Style="{StaticResource Label}"
                                                            Text="{Binding StatusText}"
                                                            TextColor="{Binding StatusColor}"
                                                            VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Grid>

                                                <!-- Expanded detail — full amounts, dis-tare note, actions -->
                                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="8">

                                                    <Label
                                                        FontSize="14"
                                                        Style="{StaticResource Label}"
                                                        Text="{Binding AmountsText}"
                                                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                    Dark={StaticResource 1}}" />

                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        IsVisible="{Binding RequiresDisTaring}"
                                                        Style="{StaticResource Label}"
                                                        Text="Requiere destare"
                                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                                    Dark={StaticResource 2}}" />

                                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                                                        <Button
                                                            Clicked="BtnConvertLine_Clicked"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding CanConvert}"
                                                            Style="{StaticResource BotonChico}"
                                                            Text="Pesar" />
                                                        <Button
                                                            BackgroundColor="DarkRed"
                                                            Clicked="BtnCloseLine_Clicked"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding CanClose}"
                                                            Style="{StaticResource BotonChico}"
                                                            Text="Cerrar"
                                                            TextColor="White" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label
                                        FontSize="15"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource Label}"
                                        Text="Este pedido aún no tiene productos"
                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                    Dark={StaticResource 2}}" />
                                </CollectionView.EmptyView>
                            </CollectionView>

                            <!-- Add line panel -->
                            <Border
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                                  Dark={StaticResource BlackGray}}"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="0">
                                <VerticalStackLayout Spacing="10">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Style="{StaticResource Label}"
                                        Text="Agregar Producto"
                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                    Dark={StaticResource 2}}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label
                                                x:Name="LblNewLineProduct"
                                                FontSize="15"
                                                Style="{StaticResource Label}"
                                                Text="Sin producto seleccionado"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource 1}}" />
                                        </VerticalStackLayout>
                                        <Button
                                            x:Name="BtnPickNewLineProduct"
                                            Grid.Column="1"
                                            Clicked="BtnPickNewLineProduct_Clicked"
                                            Style="{StaticResource Boton}"
                                            Text="Seleccionar" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Entry
                                            x:Name="EntryNewLineAmount"
                                            Grid.Column="0"
                                            Keyboard="Numeric"
                                            Placeholder="Cantidad requerida (kg)" />
                                        <Entry
                                            x:Name="EntryNewLinePrice"
                                            Grid.Column="1"
                                            Keyboard="Numeric"
                                            Placeholder="Precio unitario (opcional)" />
                                    </Grid>

                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox x:Name="ChkNewLineDisTaring" VerticalOptions="Center" />
                                        <Label
                                            FontSize="15"
                                            Style="{StaticResource Label}"
                                            Text="Requiere destare"
                                            TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                        Dark={StaticResource 1}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Button
                                        x:Name="BtnAddLine"
                                        Clicked="BtnAddLine_Clicked"
                                        HorizontalOptions="Fill"
                                        Style="{StaticResource BotonPrincipal}"
                                        Text="Agregar Línea" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Android bottom bar -->
            <Grid
                Grid.Row="{OnPlatform Android=3}"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10"
                IsVisible="{OnPlatform Android=True, WinUI=False}"
                Padding="10,0">

                <Button
                    x:Name="BtnSaveAndroid"
                    AutomationProperties.AutomationId="PedidoForm_SaveAndroid"
                    Grid.Column="0"
                    Clicked="BtnSave_Clicked"
                    Style="{StaticResource BotonPrincipal}"
                    Text="Guardar" />

                <Button
                    x:Name="BtnDeleteAndroid"
                    AutomationProperties.AutomationId="PedidoForm_DeleteAndroid"
                    BackgroundColor="DarkRed"
                    Grid.Column="1"
                    Clicked="BtnDelete_Clicked"
                    IsVisible="False"
                    Style="{StaticResource Boton}"
                    Text="Eliminar"
                    TextColor="White" />

                <Button
                    x:Name="BtnBackAndroid"
                    AutomationProperties.AutomationId="PedidoForm_BackAndroid"
                    Grid.Column="2"
                    Clicked="BtnBack_Clicked"
                    Style="{StaticResource Boton}"
                    Text="Regresar" />
            </Grid>
        </Grid>

        <components:WaitPopUp x:Name="WaitPopUp" />
        <components:ConvertLineToWeightPopUp x:Name="ConvertPopUp" />
    </Grid>
</ContentPage>
