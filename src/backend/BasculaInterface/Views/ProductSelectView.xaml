<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BasculaInterface.Views.ProductSelectView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BasculaInterface.Views.PopUps"
    xmlns:vm="clr-namespace:BasculaInterface.ViewModels"
    Title="ProductSelectView"
    BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                      Dark={StaticResource BlackTheme}}">

    <ContentPage.BindingContext>
        <vm:ProductSelectorViewModel />
    </ContentPage.BindingContext>
    <Grid>
        <Grid
            Padding="35"
            BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                              Dark={StaticResource BlackTheme}}"
            HorizontalOptions="Fill"
            RowDefinitions="auto,50,*,100"
            RowSpacing="25"
            VerticalOptions="Fill">
            <!--  Fila de búsqueda  -->
            <Grid Grid.Row="0">

                <!--  Barra de búsqueda (ocupa toda la fila 1)  -->
                <SearchBar
                    x:Name="SearchBar"
                    AutomationProperties.AutomationId="SearchBar"
                    Grid.Row="1"
                    CancelButtonColor="Black"
                    HorizontalOptions="Fill"
                    Placeholder="Buscar Producto..."
                    PlaceholderColor="Gray"
                    SearchButtonPressed="SearchBar_SearchButtonPressed"
                    Style="{StaticResource SearchBarDatos}" />
            </Grid>

            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Center">

                <Label
                    FontSize="32"
                    HorizontalOptions="Center"
                    Style="{StaticResource Label}"
                    Text="Producto seleccionado: "
                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                Dark={StaticResource 1}}"
                    VerticalOptions="Center" />

                <Label
                    x:Name="LabelResultado"
                    AutomationProperties.AutomationId="LabelResultado"
                    FontSize="32"
                    HorizontalOptions="Center"
                    Style="{StaticResource Label}"
                    TextColor="{AppThemeBinding Light={StaticResource 4},
                                                Dark={StaticResource 2}}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            <!--  Resultados  -->

            <Grid
                Grid.Row="2" >

                <CollectionView
                    x:Name="ResultsCollectionView"
                    AutomationProperties.AutomationId="ResultsCollectionView"
                    ItemsSource="{Binding Products}"
                    SelectionChanged="ResultsCollectionView_SelectionChanged"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="selectedResult"
                                AutomationProperties.AutomationId="selectedResult"
                                AutomationProperties.IsInAccessibleTree="True"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                                  Dark={StaticResource BlackGray}}"
                                HeightRequest="75"
                                Shadow="{StaticResource DefaultShadow}"
                                Stroke="{StaticResource 1}"
                                StrokeShape="RoundRectangle 30"
                                StrokeThickness="0">
                                <Grid ColumnDefinitions="30,*,Auto">

                                    <!--  Nombre  -->
                                    <Label
                                        x:Name="LabelNombre"
                                        Grid.Column="1"
                                        FontSize="25"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource Label}"
                                        Text="{Binding Nombre}"
                                        TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                    Dark={StaticResource 2}}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <!--  Estados visuales  -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="SelectionStates">
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BlackGray}, Dark={StaticResource 4}}" />
                                                <Setter TargetName="LabelNombre" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource 2}, Dark={StaticResource 1}}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=LightGray, Dark={StaticResource WhiteGray}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Normal" />


                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Grid Padding="10">

                            <Label
                                FontAttributes="Italic"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="No se encontraron productos."
                                TextColor="Gray"
                                VerticalOptions="Center" />
                        </Grid>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*,*">

                <Border
                    x:Name="BtnBack"
                    Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray},
                                                      Dark={StaticResource BlackGray}}"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    Shadow="{StaticResource DefaultShadow}"
                    Stroke="{StaticResource 1}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="0"
                    Style="{StaticResource RoundedBorderStyle}"
                    WidthRequest="250">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        HorizontalOptions="Fill"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Image
                            x:Name="BackIcon"
                            Aspect="AspectFit"
                            HeightRequest="50"
                            HorizontalOptions="Fill"
                            Source="{AppThemeBinding Light='back2.png',
                                                     Dark='back.png'}"
                            VerticalOptions="Fill"
                            WidthRequest="50" />

                        <Label
                            x:Name="BackLabel" FontAttributes="Bold"
                            FontSize="16"
                            Style="{StaticResource Label}"
                            Text="Volver"
                            TextColor="{AppThemeBinding Light={StaticResource Black},
                                                        Dark={StaticResource 1}}" />

                    </VerticalStackLayout>



                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter TargetName="BackIcon" Property="Image.Source" Value="back.png" />
                                        <Setter TargetName="BackLabel" Property="Label.TextColor" Value="{StaticResource 1}" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource 4}" />
                                        <Setter Property="Stroke" Value="{StaticResource 1}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource 2}" />
                                        <Setter TargetName="DeleteLabel" Property="Label.TextColor" Value="{StaticResource 4}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Border>


                <Border
                    x:Name="BtnConfirm"
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray},
                                                      Dark={StaticResource BlackGray}}"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    Shadow="{StaticResource DefaultShadow}"
                    Stroke="{StaticResource 1}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="0"
                    Style="{StaticResource RoundedBorderStyle}"
                    WidthRequest="250">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmClicked" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        HorizontalOptions="Fill"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Image
                            x:Name="AddIcon"
                            Aspect="AspectFit"
                            HeightRequest="50"
                            HorizontalOptions="Fill"
                            Source="{AppThemeBinding Light='addproduct.png',
                                                     Dark='addproduct2.png'}"
                            VerticalOptions="Fill"
                            WidthRequest="50" />

                        <Label
                            x:Name="AddLabel" FontAttributes="Bold"
                            FontSize="16"
                            Style="{StaticResource Label}"
                            Text="Confirmar Producto"
                            TextColor="{AppThemeBinding Light={StaticResource Black},
                                                        Dark={StaticResource 1}}" />

                    </VerticalStackLayout>



                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter TargetName="AddIcon" Property="Image.Source" Value="addproduct2.png" />
                                        <Setter TargetName="AddLabel" Property="Label.TextColor" Value="{StaticResource 1}" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource 4}" />
                                        <Setter Property="Stroke" Value="{StaticResource 1}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource 2}" />
                                        <Setter TargetName="DeleteLabel" Property="Label.TextColor" Value="{StaticResource 4}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Border>

            </Grid>
        </Grid>
        <components:WaitPopUp x:Name="WaitPopUp" />
    </Grid>


</ContentPage>