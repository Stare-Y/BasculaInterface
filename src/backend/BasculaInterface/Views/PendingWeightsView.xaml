<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BasculaInterface.Views.PendingWeightsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BasculaInterface.Views.PopUps"
    xmlns:vm="clr-namespace:BasculaInterface.ViewModels"
    xmlns:models="clr-namespace:BasculaInterface.Models"
    xmlns:local="clr-namespace:BasculaInterface.Resources.Converters"
    Title="Pedidos en Proceso"
    BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                      Dark={StaticResource BlackTheme}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:UtcToLocalConverter x:Key="UtcToLocalConverter"/>
            <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>

        <Grid
            Padding="30"
            BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                              Dark={StaticResource BlackTheme}}"
            ColumnDefinitions="*,3*"
            ColumnSpacing="30" >


            <BoxView HeightRequest="2"
                HorizontalOptions="Fill"
                IsVisible="False"
                VerticalOptions="Start"
                Color="{AppThemeBinding Light={StaticResource 4},
                                        Dark={StaticResource Gray}}" />


            <Border
                Padding="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                  Dark={StaticResource BlackGray}}"
                IsVisible="True"
                Shadow="{StaticResource DefaultShadow}"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0">


                <Grid Grid.Column="0" ColumnSpacing="15"
                    RowDefinitions="*,*,*,*,*"
                    RowSpacing="15">


                    <Button
                        x:Name="BtnReconnect"
                        Grid.Row="2" IsVisible="False"
                        Pressed="BtnReconnect_Pressed"
                        Released="BtnReconnect_Released"
                        Style="{StaticResource Boton}"
                        Text="Reconectar" />

                    <Button
                        x:Name="BtnRefresh"
                        Grid.Row="1" IsVisible="True"
                        Pressed="BtnReconnect_Pressed"
                        Released="BtnReconnect_Released"
                        Style="{StaticResource Boton}"
                        Text="Actualizar" />

                    <Button
                        x:Name="BtnNewWeighProcess"
                        Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource 4},
                                                          Dark={StaticResource 2}}"
                        AutomationProperties.AutomationId="BtnNewWeighProcess"
                        Clicked="BtnNewWeighProcess_Clicked"
                        IsVisible="True"
                        Style="{StaticResource BotonPrincipal}"
                        Text="Nueva Entrada"
                        ToolTipProperties.Text="Nueva Entrada (F5)" />
                    <Button
                        x:Name="BtnNewWeightLessPedido"
                        Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource 4},
                                                          Dark={StaticResource 2}}"
                        AutomationProperties.AutomationId="BtnNewWeightLessPedido"
                        Clicked="OnBtnNewWeighlessProcess_clicked"
                        IsVisible="False"
                        Style="{StaticResource BotonPrincipal}"
                        Text="Nuevo Pedido sin Pesada"
                        ToolTipProperties.Text="Nuevo Pedido sin Pesada (F8)" />

                    <Button
                        x:Name="BtnComprasProveedor"
                        Grid.Row="2"
                        Clicked="BtnComprasProveedor_Clicked"
                        IsVisible="False"
                        Style="{StaticResource Boton}"
                        Text="Compras"
                        ToolTipProperties.Text="Ver Compras" />

                    <Button
                        x:Name="BtnFinished"
                        Grid.Row="3"
                        AutomationProperties.AutomationId="BtnFinished"
                        Clicked="BtnFinished_Clicked" Style="{StaticResource Boton}"
                        Text="Ver Finalizados"
                        ToolTipProperties.Text="Ver Finalizados (F6)" />
                    
                    <Button
                        x:Name="BtnExit"
                        Grid.Row="4"
                        Clicked="BtnExit_Clicked" Style="{StaticResource Boton}"
                        Text="Salir"
                        ToolTipProperties.Text="Salir (Esc)" />

                    <!--  What is this?  -->
                    <Border
                        x:Name="BorderEntryHost"
                        Grid.Column="1"
                        Padding="5"
                        BackgroundColor="White"
                        IsVisible="False"
                        Stroke="#ccc"
                        StrokeShape="RoundRectangle 30"
                        StrokeThickness="1">
                        <Entry
                            x:Name="EntryHost"
                            FontSize="Subtitle"
                            Placeholder="Host"
                            TextColor="Black" />
                    </Border>


                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*"
                RowSpacing="20" >

                <Grid
                    x:Name="GridListTab"
                    Grid.Row="0"
                    ColumnDefinitions="*,*">

                    <Button
                        x:Name="BtnCargas"
                        Grid.Column="0"
                        Clicked="CargasDescargasToggle"
                        CornerRadius="20"
                        HeightRequest="60"
                        IsEnabled="False"
                        Style="{StaticResource Boton}"
                        Text="Cargas"
                        WidthRequest="350" />

                    <Button
                        x:Name="BtnDescargas"
                        Grid.Column="1"
                        Clicked="CargasDescargasToggle"
                        CornerRadius="20"
                        HeightRequest="60"
                        Shadow="{StaticResource DefaultShadow}"
                        Style="{StaticResource Boton}"
                        Text="Descargas"
                        WidthRequest="350" />

                </Grid>

                <Grid Grid.Row="1">
                    <Picker 
                        x:Name="PickerDocumentType"
                        ItemsSource="{Binding AvailableDocumentTypes}"
                        ItemDisplayBinding="{Binding DisplayText}"
                        IsVisible="False"
                        SelectedIndexChanged="PickerDocumentType_SelectedIndexChanged">
                        
                    </Picker>
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="15"
                    Stroke="{StaticResource BlackTheme}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="0">

                    <RefreshView
                        x:Name="RefreshViewPendingWeights"
                        Command="{Binding RefreshCommand}"
                        IsRefreshing="{Binding IsRefreshing}">

                        <CollectionView
                            x:Name="PendingWeightsCollectionView"
                            AutomationProperties.AutomationId="PendingWeightsCollectionView"
                            HorizontalOptions="Center"
                            SelectionChanged="PendingWeightsCollectionView_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="Start">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PendingWeightViewRow">
                                    <Border
                                        x:Name="BtnSeleccionar"
                                        AutomationProperties.AutomationId="BtnSeleccionar"
                                        Padding="15"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                                          Dark={StaticResource BlackGray}}"
                                        InputTransparent="False"
                                        MaximumHeightRequest="250"
                                        MinimumHeightRequest="110"
                                        Stroke="{StaticResource 1}"
                                        StrokeShape="RoundRectangle 30"
                                        StrokeThickness="0">
                                        <Grid
                                            ColumnDefinitions="*,auto"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                HorizontalOptions="Fill"
                                                Spacing="10">
                                                <Label
                                                    x:Name="lblRazonSocial"
                                                    FontAttributes="Bold"
                                                    FontSize="26"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding Partner.RazonSocial}"
                                                    TextColor="{AppThemeBinding Light={StaticResource 4},
                                                                                Dark={StaticResource 2}}" />

                                                <Label
                                                    x:Name="lblPlacas"
                                                    FontSize="26"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding WeightEntry.VehiclePlate, StringFormat='Placas: {0} '}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                Dark={StaticResource 1}}" />
                                                <Label
                                                    x:Name="lblNotas"
                                                    FontSize="24"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    MaximumWidthRequest="800"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding WeightEntry.Notes, StringFormat='Chofer: {0}.'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                Dark={StaticResource 1}}" />
                                                <Label
                                                    x:Name="lblRequestedProduct"
                                                    FontSize="24"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    MaximumWidthRequest="800"
                                                    IsVisible="{Binding RequestedProduct, Converter={x:StaticResource IsNotNullConverter}}"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding RequestedProduct, StringFormat='Producto: {0}'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                Dark={StaticResource 1}}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">

                                                <Label
                                                    x:Name="lblTara"
                                                    Margin="0,0,0,0"
                                                    FontAttributes="Bold"
                                                    FontSize="22"
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding WeightEntry.TareWeight, StringFormat='Tara: {0} kg'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                                Dark={StaticResource 1}}" />

                                                <Label
                                                    x:Name="lblHistory"
                                                    FontSize="22"
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource Label}"
                                                    Text="{Binding HistoryText}"
                                                    TextColor="{StaticResource 2}" />

                                                <Label
                                                    Text="{Binding WeightEntry.CreatedAt, Converter={StaticResource UtcToLocalConverter}, StringFormat='{0:dd/MM HH:mm}'}"
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource Label}"
                                                    FontSize="20"
                                                    VerticalOptions="Center"
                                                    TextColor="Orange"
                                                    />

                                            </VerticalStackLayout>
                                        </Grid>

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=LightGray, Dark={StaticResource WhiteGray}}" />
                                                            <Setter Property="Stroke" Value="{StaticResource 2}" />
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource 4}, Dark={StaticResource 1}}" />
                                                            <Setter Property="Stroke" Value="{StaticResource 2}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>

                                <Grid
                                    Padding="250"
                                    HorizontalOptions="Center"
                                    RowDefinitions="*,*"
                                    RowSpacing="50"
                                    VerticalOptions="Fill">

                                    <Image
                                        Grid.Row="0"
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        HorizontalOptions="Center"
                                        Source="info.png"
                                        VerticalOptions="Center"
                                        WidthRequest="100" />

                                    <Label
                                        Grid.Row="1"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource Label}"
                                        Text="No hay pedidos pendientes"
                                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                    Dark={StaticResource 1}}"
                                        VerticalOptions="Center" />
                                </Grid>

                            </CollectionView.EmptyView>

                        </CollectionView>

                    </RefreshView>

                </Border>
            </Grid>
        </Grid>
        <components:WaitPopUp x:Name="WaitPopUp" />
        <components:AuthorizeTurnBypassPopUp x:Name="AuthorizeTurnBypassPopUp" />
    </Grid>

</ContentPage>