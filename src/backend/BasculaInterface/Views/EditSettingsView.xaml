<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BasculaInterface.Views.EditSettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BasculaInterface.Views.PopUps"
    Title="EditSettingsView">

    <Grid>

        <Image Aspect="AspectFill" Source="background.png" />

        <Grid Padding="125">

            <Border
                Padding="30"
                BackgroundColor="{AppThemeBinding Light={StaticResource WhiteGray},
                                                  Dark={StaticResource BlackGray}}"
                Shadow="{StaticResource DefaultShadow}"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0">

                <Grid RowDefinitions="auto,2*,auto" RowSpacing="30 ">



                    <!--  Elementos ocultos opcionales  -->
                    <StackLayout
                        Grid.Row="0"
                        Spacing="15"
                        VerticalOptions="Start">
                        <Label
                            Style="{StaticResource Label}"
                            Text="Entrada de Host"
                            TextColor="{AppThemeBinding Light={StaticResource 3},
                                                        Dark={StaticResource 2}}" />
                        <Border
                            x:Name="BorderEntryHost"
                            BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                                              Dark={StaticResource BlackTheme}}"
                            HorizontalOptions="Fill"
                            IsVisible="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 20"
                            VerticalOptions="Center">
                            <Entry
                                x:Name="EntryHost"
                                BackgroundColor="{AppThemeBinding Light={StaticResource 1},
                                                                  Dark={StaticResource BlackTheme}}"
                                Placeholder="Ingrese la Direccion del Host..."
                                Style="{StaticResource EntryDatos}" />
                        </Border>
                    </StackLayout>

                    <ScrollView
                        x:Name="ScrollCheckBox"
                        Grid.Row="1"
                        IsVisible="True"
                        Orientation="Horizontal"
                        VerticalOptions="Center">

                        <VerticalStackLayout
                            x:Name="StackCheckBox"
                            HorizontalOptions="Center"
                            IsVisible="True"
                            Spacing="20"
                            VerticalOptions="Center">

                            <!--  "Capturar peso manualmente" removed (issue #134) — manual-weight
                                  capture is now gated solely by the logged-in user's
                                  CanCaptureWeightManually permission, not a device setting.  -->

                            <!--  "Usar terminal secundaria", "Solo Pedidos", "Ver solo Terminados", and
                                  "Forzar elegir socio" removed (role-driven-terminal-modes, issue #135) —
                                  terminal-mode behavior (Main/Secondary/PedidosOnly/OnlyFinished) is now
                                  derived from the logged-in user's role/TerminalModeOverride, not a
                                  per-device setting; RequirePartner was confirmed dead in production and
                                  deleted outright. BypasTurn remains — see design.md Decision 3, it now
                                  requires a self-authorize-gate credential at the moment of use.  -->

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <CheckBox
                                    x:Name="CheckBoxBypasTurn"
                                    AutomationProperties.AutomationId="CheckBoxBypasTurn"
                                    Grid.Column="0"
                                    CheckedChanged="CheckBoxBypasTurn_CheckedChanged"
                                    HorizontalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Omitir Turno de Bascula" />

                            </Grid>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <CheckBox
                                    x:Name="CheckBoxShowDocumentTypes"
                                    Grid.Column="0"
                                    CheckedChanged="CheckBoxShowDocumentTypes_CheckedChanged"
                                    HorizontalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Mostrar filtro de tipos de documento" />

                            </Grid>
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <CheckBox
                                    x:Name="CheckBoxFilterNull"
                                    Grid.Column="0"
                                    CheckedChanged="CheckBoxDontFilterNull_CheckedChanged"
                                    HorizontalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Filtrar Nulos (si marcado, al filtrar, los nulos no apareceran)" />

                            </Grid>
                            
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                IsVisible="True"
                                VerticalOptions="Center">

                                <CheckBox
                                    x:Name="CheckBoxHideTaskbar"
                                    Grid.Column="0"
                                    CheckedChanged="CheckBoxHideTaskbar_CheckedChanged"
                                    HorizontalOptions="Start" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Ocultar barra de tareas al maximizar" />

                            </Grid>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <Entry
                                    x:Name="EntryDocumentTypes"
                                    Grid.Column="0"
                                    HorizontalOptions="Start"
                                    Placeholder="Id de documento preferido"
                                    TextChanged="EntryDocumentTypes_TextChanged" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Id de tipo de documento por default" />

                            </Grid>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <Entry
                                    x:Name="EntryPurchaseExternalTarget"
                                    Grid.Column="0"
                                    HorizontalOptions="Start"
                                    Placeholder="Id de documento Compras"
                                    TextChanged="EntryPurchaseExternalTarget_TextChanged" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Id de tipo de documento para compras" />

                            </Grid>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="35"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">

                                <Picker
                                    x:Name="PickerTheme"
                                    Grid.Column="0"
                                    HorizontalOptions="Start"
                                    SelectedIndexChanged="PickerTheme_SelectedIndexChanged"
                                    WidthRequest="200">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Sistema</x:String>
                                            <x:String>Claro</x:String>
                                            <x:String>Oscuro</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Label
                                    Grid.Column="1"
                                    FontSize="22"
                                    HorizontalOptions="End"
                                    Style="{StaticResource Label}"
                                    Text="Tema de la aplicación" />

                            </Grid>

                        </VerticalStackLayout>

                    </ScrollView>

                    <Grid
                        Grid.Row="2"
                        Padding="5"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="25"
                        HorizontalOptions="Fill"
                        VerticalOptions="End">

                        <!--  Button to go back  -->
                        <Border
                            x:Name="BtnCancel"
                            AutomationProperties.AutomationId="EditSettings_BtnCancel"
                            AutomationProperties.IsInAccessibleTree="True"
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray},
                                                              Dark={StaticResource BlackGray}}"
                            HeightRequest="80"
                            HorizontalOptions="Center"
                            Shadow="{StaticResource DefaultShadow}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 30"
                            Style="{StaticResource RoundedBorderStyle}"
                            WidthRequest="250">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnCancel_Clicked" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout HorizontalOptions="Fill" VerticalOptions="Center">

                                <Image
                                    x:Name="BackIcon"
                                    Aspect="AspectFit"
                                    HeightRequest="50"
                                    Source="{AppThemeBinding Light='back2.png',
                                                             Dark='back.png'}"
                                    WidthRequest="50" />

                                <Label
                                    x:Name="BackLabel"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Style="{StaticResource Label}"
                                    Text="Volver"
                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                Dark={StaticResource 1}}" />

                            </VerticalStackLayout>



                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource 4}, Dark={StaticResource 4}}" />
                                                <Setter TargetName="BackIcon" Property="Image.Source" Value="{AppThemeBinding Light='back.png', Dark='back2.png'}" />
                                                <Setter TargetName="BackLabel" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource 1}, Dark={StaticResource Black}}" />
                                                <Setter Property="Stroke" Value="{StaticResource 2}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource 2}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Border>

                        <!--  Button to save current settings  -->
                        <Border
                            x:Name="BtnSaveSettings"
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray},
                                                              Dark={StaticResource BlackGray}}"
                            HeightRequest="80"
                            HorizontalOptions="Center"
                            Shadow="{StaticResource DefaultShadow}"
                            Stroke="{AppThemeBinding Light={StaticResource 4},
                                                     Dark={StaticResource 2}}"
                            StrokeShape="RoundRectangle 30"
                            StrokeThickness="3"
                            Style="{StaticResource RoundedBorderStyle}"
                            WidthRequest="250">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnSaveSettings_Clicked" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                HorizontalOptions="Fill"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Image
                                    x:Name="CaptureSettingsImage"
                                    Aspect="AspectFit"
                                    HeightRequest="40"
                                    HorizontalOptions="Fill"
                                    Source="{AppThemeBinding Light='confirm.png',
                                                             Dark='confirm2.png'}"
                                    VerticalOptions="Fill"
                                    WidthRequest="40" />

                                <Label
                                    x:Name="CaptureSettingsLabel"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Style="{StaticResource Label}"
                                    Text="Guardar Configuracion"
                                    TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                Dark={StaticResource 1}}" />

                            </VerticalStackLayout>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource 4}, Dark={StaticResource 4}}" />
                                                <Setter TargetName="CaptureSettingsImage" Property="Image.Source" Value="{AppThemeBinding Light='confirm2.png', Dark='confirm.png'}" />
                                                <Setter TargetName="CaptureSettingsLabel" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource 1}, Dark={StaticResource Black}}" />
                                                <Setter Property="Stroke" Value="{StaticResource 2}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource 2}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <components:WaitPopUp x:Name="WaitPopUp" />

    </Grid>

</ContentPage>