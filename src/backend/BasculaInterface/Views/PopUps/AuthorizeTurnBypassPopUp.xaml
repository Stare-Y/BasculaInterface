<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BasculaInterface.Views.PopUps.AuthorizeTurnBypassPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="False">

    <Grid
        BackgroundColor="#80000000"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        ZIndex="999">
        <Grid
            x:Name="PopupOverlay"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource 4},
                                              Dark={StaticResource 2}}"
            HorizontalOptions="Center"
            MaximumWidthRequest="400"
            MinimumWidthRequest="300"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15"
            VerticalOptions="Center">

            <!--  Title  -->
            <Label
                Grid.Row="0"
                FontSize="18"
                HorizontalOptions="Center"
                Text="Báscula ocupada" />

            <!--  Explanation of what's being authorized — role-driven-terminal-modes design.md
                  Decision 3: BypasTurn overrides the single-scale busy lock, so using it now
                  requires the same self-authorize gate as every other guarded action.  -->
            <Label
                x:Name="MessageLabel"
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Autorice para continuar aunque la báscula esté ocupada" />

            <!--  Self-authorize gate identifier (UserCode or Username) — issue #134  -->
            <Entry
                x:Name="IdentifierEntry"
                Grid.Row="2"
                AutomationProperties.AutomationId="AuthorizeTurnBypass_IdentifierEntry"
                HorizontalOptions="Fill"
                Placeholder="Usuario o código..."
                ReturnType="Next" />

            <!--  Password Entry  -->
            <Entry
                x:Name="PasswordEntry"
                Grid.Row="3"
                AutomationProperties.AutomationId="AuthorizeTurnBypass_PasswordEntry"
                HorizontalOptions="Fill"
                IsPassword="True"
                Placeholder="Contraseña..."
                ReturnType="Done"
                Completed="PasswordEntry_Completed" />

            <!--  Action Buttons  -->
            <HorizontalStackLayout
                Grid.Row="4"
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnCancel"
                    AutomationProperties.AutomationId="btnCancel"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary},
                                                      Dark={StaticResource BlackGray}}"
                    Clicked="OnPopupCancelClicked"
                    CornerRadius="20"
                    FontSize="18"
                    HeightRequest="50"
                    Style="{StaticResource Boton}"
                    Text="Cancelar"
                    WidthRequest="150" />

                <Button
                    x:Name="btnConfirm"
                    AutomationProperties.AutomationId="btnConfirm"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary},
                                                      Dark={StaticResource BlackGray}}"
                    Clicked="OnPopupAcceptClicked"
                    CornerRadius="20"
                    FontSize="18"
                    HeightRequest="50"
                    Style="{StaticResource Boton}"
                    Text="Confirmar"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
