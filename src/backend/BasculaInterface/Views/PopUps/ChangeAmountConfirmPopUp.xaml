<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BasculaInterface.Views.PopUps.ChangeAmountConfirmPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="False">

    <!--
        Modeled directly on ChangeProductConfirmPopUp (issue #122), extended with an extra
        numeric Entry for the new value (issue #124's "Cambiar peso"/"Cambiar cantidad" flow).
    -->
    <Grid
        BackgroundColor="#80000000"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        ZIndex="999">
        <Grid
            x:Name="PopupOverlay"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource 4},
                                              Dark={StaticResource 2}}"
            HorizontalOptions="Center"
            MaximumWidthRequest="400"
            MinimumWidthRequest="300"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15"
            VerticalOptions="Center">

            <!--  Title  -->
            <Label
                x:Name="TitleLabel"
                Grid.Row="0"
                FontSize="18"
                HorizontalOptions="Center"
                Text="Cambiar peso a:" />

            <!--  Current value  -->
            <Label
                x:Name="CurrentValueLabel"
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="Actual: 0 kg" />

            <!--  New value Entry  -->
            <Entry
                x:Name="NewValueEntry"
                Grid.Row="2"
                HorizontalOptions="Fill"
                Keyboard="Numeric"
                Placeholder="Nuevo valor..."
                ReturnType="Next" />

            <!--  Self-authorize gate identifier (UserCode or Username) — issue #134  -->
            <Entry
                x:Name="IdentifierEntry"
                Grid.Row="3"
                HorizontalOptions="Fill"
                Placeholder="Usuario o código..."
                ReturnType="Next" />

            <!--  Password Entry  -->
            <Entry
                x:Name="PasswordEntry"
                Grid.Row="4"
                HorizontalOptions="Fill"
                IsPassword="True"
                Placeholder="Contraseña..."
                ReturnType="Done"
                Completed="PasswordEntry_Completed" />

            <!--  Action Buttons  -->
            <HorizontalStackLayout
                Grid.Row="5"
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnCancel"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary},
                                                      Dark={StaticResource BlackGray}}"
                    Clicked="OnPopupCancelClicked"
                    CornerRadius="20"
                    FontSize="18"
                    HeightRequest="50"
                    Style="{StaticResource Boton}"
                    Text="Cancelar"
                    WidthRequest="150" />

                <Button
                    x:Name="btnConfirm"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary},
                                                      Dark={StaticResource BlackGray}}"
                    Clicked="OnPopupAcceptClicked"
                    CornerRadius="20"
                    FontSize="18"
                    HeightRequest="50"
                    Style="{StaticResource Boton}"
                    Text="Confirmar"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
