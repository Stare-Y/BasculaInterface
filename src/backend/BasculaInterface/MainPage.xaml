<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BasculaInterface.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:BasculaInterface.Views.PopUps"
    xmlns:local="clr-namespace:BasculaInterface"
    xmlns:vm="clr-namespace:BasculaInterface.ViewModels">

    <Grid>

        <Image Aspect="AspectFill" Source="background.png" />

        <Grid
            Padding="30"
            RowDefinitions="1.5*,Auto,Auto,*"
            RowSpacing="30">

            <!--  Título de bienvenida  -->
            <StackLayout Grid.Row="0" Margin="0,50,0,0">

                <Image Source="logo.png" Style="{StaticResource Logo}" />

            </StackLayout>

            <Label
                Grid.Row="1"
                FontAttributes="Bold"
                FontFamily="42"
                Style="{StaticResource Label}"
                Text="Control de basculas y pedidos" />

            <!--  Formulario de inicio de sesión real (issue #134) — reemplaza el botón de
                  presión-larga anterior, que no pedía ninguna credencial.  -->
            <Grid
                Grid.Row="2"
                HorizontalOptions="Center"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="15"
                VerticalOptions="Center"
                WidthRequest="450">

                <Entry
                    x:Name="IdentifierEntry"
                    Grid.Row="0"
                    AutomationProperties.AutomationId="IdentifierEntry"
                    HorizontalOptions="Fill"
                    Placeholder="Usuario o código..."
                    ReturnType="Next" />

                <Entry
                    x:Name="PasswordEntry"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="PasswordEntry"
                    Completed="PasswordEntry_Completed"
                    HorizontalOptions="Fill"
                    IsPassword="True"
                    Placeholder="Contraseña..."
                    ReturnType="Done" />

                <Label
                    x:Name="LoginErrorLabel"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="LoginErrorLabel"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    Text="Credenciales inválidas."
                    TextColor="Red" />

                <Button
                    x:Name="BtnLogIn"
                    Grid.Row="3"
                    AutomationProperties.AutomationId="BtnLogIn"
                    FontSize="36"
                    HeightRequest="120"
                    Clicked="BtnLogin_Clicked"
                    Shadow="{StaticResource DefaultShadow}"
                    Style="{StaticResource Boton}"
                    Text="Ingresar"
                    WidthRequest="450" />
            </Grid>

            <!--  Acceso a configuración — siempre visible ahora que ya no depende de la
                  presión-larga del botón de login.  -->
            <StackLayout
                Grid.Row="3"
                Spacing="10"
                VerticalOptions="End">

                <HorizontalStackLayout HorizontalOptions="Center">

                    <Border
                        x:Name="BtnSettings"
                        AutomationProperties.AutomationId="BtnSettings"
                        AutomationProperties.IsInAccessibleTree="True"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray},
                                                          Dark={StaticResource BlackGray}}"
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        Stroke="{StaticResource 1}"
                        StrokeShape="RoundRectangle 30"
                        Style="{StaticResource RoundedBorderStyle}"
                        WidthRequest="100">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnSettings_Tapped" />
                        </Border.GestureRecognizers>


                        <Image
                            x:Name="imgSettings"
                            Aspect="AspectFit"
                            HeightRequest="60"
                            Source="{AppThemeBinding Light='settings.png',
                                                     Dark='settings.png'}"
                            WidthRequest="60" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource 1}, Dark={StaticResource 4}}" />
                                            <Setter Property="Stroke" Value="{StaticResource 2}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource 2}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Border>

                </HorizontalStackLayout>
            </StackLayout>

        </Grid>

        <components:WaitPopUp x:Name="WaitPopUp" />

    </Grid>

</ContentPage>
